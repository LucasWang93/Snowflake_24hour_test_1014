# Preparation only: no service or credential is required.
# Add variable NAMES with empty values only after actual requirements are known.
# Never put credentials in this file. Scripts never source .env files.

# Snowflake connection; copy names into a local .env and supply values there.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# A live-tested Cortex model; set the chosen model in local .env.
SNOWFLAKE_CORTEX_MODEL=
